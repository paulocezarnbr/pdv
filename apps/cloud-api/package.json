{
  "name": "@erpfood/cloud-api",
  "version": "1.0.0",
  "private": true,
  "description": "Retaguarda do ERP de food service: sincronizacao, ativacao de terminais e comandos do painel.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "sign": "tsx scripts/sign.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run",
    "e2e": "python scripts/e2e.py"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.73.0",
    "@carbon/react": "^1.94.0",
    "@node-rs/argon2": "2.0.2",
    "next": "15.5.25",
    "postgres": "3.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
