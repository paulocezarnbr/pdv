# =============================================================================
# Variaveis da retaguarda
# =============================================================================
# No Coolify, cadastre estas em Environment Variables do recurso.
# As marcadas OBRIGATORIA fazem o processo recusar subir se faltarem — de
# proposito: variavel ausente virando `undefined` produz um `WHERE tenant_id =
# NULL` que nao casa com nada, e o erro aparece horas depois como "o terminal
# parou de sincronizar".

# OBRIGATORIA. Conexao que a APLICACAO usa.
# Aponte para o papel `erp_app`, que as migrations criam: ele NAO e
# superusuario, e e por isso que o isolamento por tenant no banco (RLS)
# funciona. Conectando como administrador o RLS fica INERTE — superusuario
# ignora politica, com ou sem FORCE. Ver COOLIFY.md, secao 3.
# No Coolify use o hostname INTERNO do Postgres: o trafego nao sai do servidor
# e a porta nao precisa ser publicada.
DATABASE_URL=postgres://erp_app:<APP_DB_PASSWORD>@postgres:5432/erp

# Conexao que as MIGRATIONS usam. Elas criam tabela; a aplicacao, nao — uma
# aplicacao que consegue derrubar a tabela de auditoria nao protege nada.
# E a string que o Coolify te deu ao criar o Postgres.
# Se voce omitir, as migrations usam DATABASE_URL (e ai `erp_app` nao tem
# permissao para criar tabela, e o deploy falha dizendo isso).
ADMIN_DATABASE_URL=postgres://erp:senha-do-coolify@postgres:5432/erp

# Senha do papel `erp_app`. Minimo 12 caracteres. Gere com:
#   openssl rand -base64 24
# As migrations definem a senha do papel a partir daqui, a cada subida — entao
# trocar esta variavel e redeployar troca a senha do banco junto.
# Sem ela: o papel nasce sem login, a aplicacao conecta como administrador, e
# /api/health passa a responder "tenant_isolation":"inerte".
APP_DB_PASSWORD=

# OBRIGATORIA. Chave das sessoes do painel. Gere com:
#   openssl rand -base64 48
# NAO e a chave HMAC do ledger de auditoria — essa e por terminal e nunca sai
# do terminal. Trocar esta aqui derruba as sessoes do painel e nada mais.
SESSION_SECRET=

# Opcional. Conexoes por processo. Baixo de proposito: o Coolify costuma rodar
# o Postgres no mesmo host, com max_connections=100, e tres replicas com pool
# de 20 esgotariam o banco antes de esgotar a CPU.
DATABASE_POOL_MAX=10

# Injetada pelo Coolify. Nao cadastre manualmente.
# PORT=3000

# Opcional. Aparece em /api/health; util para confirmar qual versao esta no ar.
APP_VERSION=dev
