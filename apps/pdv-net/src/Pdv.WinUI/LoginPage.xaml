<UserControl
    x:Class="Pdv.WinUI.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Quem é esta loja, e se o caixa ainda é demonstração. -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Padding="48" Spacing="12">
            <TextBlock Text="PDV Balcão" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="StoreName" AutomationProperties.AutomationId="StoreName"
                       Text="{x:Bind ViewModel.StoreName}" Style="{StaticResource TitleLargeTextBlockStyle}"
                       TextWrapping="WrapWholeWords" />
            <InfoBar AutomationProperties.AutomationId="DemoNotice"
                     IsOpen="{x:Bind ViewModel.IsDemo}" IsClosable="False" Severity="Warning"
                     Title="Modo demonstração" Message="{x:Bind ViewModel.DemoNotice}" />
            <Button AutomationProperties.AutomationId="Activate" Content="Ativar terminal…"
                    Visibility="{x:Bind ViewModel.IsDemo}" Height="40"
                    Command="{x:Bind ViewModel.RequestActivationCommand}" />
        </StackPanel>

        <!-- Login e PIN. Teclado na tela: balcão com touch e sem teclado físico. -->
        <Border Grid.Column="1" Width="380" Margin="0,48,48,48" Padding="28" CornerRadius="8"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="14">
                <TextBlock Text="Entrar no caixa" Style="{StaticResource SubtitleTextBlockStyle}" />

                <TextBox x:Name="LoginBox" AutomationProperties.AutomationId="Login" Header="Login"
                         Text="{x:Bind ViewModel.Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsSpellCheckEnabled="False" />

                <PasswordBox x:Name="PinBox" AutomationProperties.AutomationId="Pin" Header="PIN"
                             Password="{x:Bind ViewModel.Pin, Mode=TwoWay}"
                             InputScope="NumericPin" MaxLength="12" KeyDown="OnPinKeyDown" />

                <Grid x:Name="Keypad" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" /><RowDefinition Height="52" />
                        <RowDefinition Height="52" /><RowDefinition Height="52" />
                    </Grid.RowDefinitions>
                </Grid>

                <InfoBar AutomationProperties.AutomationId="Error"
                         IsOpen="{x:Bind HasError(ViewModel.Error), Mode=OneWay}" IsClosable="False"
                         Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="SignIn" Content="Entrar"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="44"
                            Command="{x:Bind ViewModel.SignInCommand}" />
                    <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Width="24" Height="24" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
