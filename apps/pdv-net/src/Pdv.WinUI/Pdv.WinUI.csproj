<Project Sdk="Microsoft.NET.Sdk">

  <!-- O caixa em WinUI 3 (Windows App SDK), sem MSIX: o mesmo instalador Inno
       de sempre copia a pasta, e o runtime do Windows App SDK vai junto
       (self-contained) - loja sem internet não baixa pré-requisito. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pdv.WinUI</RootNamespace>
    <AssemblyName>PDV</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pdv.App\Pdv.App.csproj" />
    <ProjectReference Include="..\Pdv.Edge\Pdv.Edge.csproj" />
  </ItemGroup>

</Project>
