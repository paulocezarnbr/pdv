<?xml version="1.0" encoding="utf-8"?>
<!-- O painel do salão (F8): parear e revogar aparelho, mesas abertas, quem está
     em turno e a fila da cozinha. Só apresentação: o SalonPanelViewModel faz o resto. -->
<UserControl
    x:Class="Pdv.WinUI.SalonPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Pdv.App"
    xmlns:local="using:Pdv.WinUI">

    <Grid Padding="20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pareamento: o código grande, para o garçom ler a dois metros, de pé. -->
        <StackPanel Spacing="12">
            <TextBlock Text="Parear aparelho" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock AutomationProperties.AutomationId="PairingCode" Text="{x:Bind ViewModel.Code, Mode=OneWay}"
                       FontSize="44" FontFamily="Consolas" HorizontalAlignment="Center" />
            <TextBlock AutomationProperties.AutomationId="PairingHint" Text="{x:Bind ViewModel.CodeHint, Mode=OneWay}"
                       TextWrapping="Wrap" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.AutomationId="GenerateCode" Content="Gerar código" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.GenerateCodeCommand}" />
                <Button Grid.Column="1" AutomationProperties.AutomationId="RevokeCode" Content="Revogar código"
                        HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RevokeCodeCommand}" />
            </Grid>
            <InfoBar AutomationProperties.AutomationId="SalonAddress" IsOpen="True" IsClosable="False"
                     Severity="{x:Bind AddressSeverity}" Message="{x:Bind ViewModel.Address}" />
            <InfoBar AutomationProperties.AutomationId="SalonError" IsOpen="{x:Bind Has(ViewModel.Error), Mode=OneWay}"
                     IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        </StackPanel>

        <TabView Grid.Column="1" IsAddTabButtonVisible="False" TabWidthMode="Equal">
            <TabViewItem Header="Mesas abertas" IsClosable="False">
                <ListView AutomationProperties.AutomationId="SalonOrders" ItemsSource="{x:Bind ViewModel.Orders}"
                          SelectedItem="{x:Bind ViewModel.SelectedOrder, Mode=OneWay}" SelectionChanged="OnOrderSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="app:SalonOrderRow">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="50" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Table}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Waiter}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Number}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Items}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Total}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Status}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem Header="Em turno" IsClosable="False">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListView AutomationProperties.AutomationId="SalonStaff" ItemsSource="{x:Bind ViewModel.Staff}"
                              SelectedItem="{x:Bind ViewModel.SelectedPerson, Mode=OneWay}" SelectionChanged="OnPersonSelected">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="app:SalonPersonRow">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Role}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Seen}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="1" AutomationProperties.AutomationId="EndShift" Content="Encerrar turno"
                            Command="{x:Bind ViewModel.EndShiftCommand}" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Aparelhos" IsClosable="False">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListView AutomationProperties.AutomationId="SalonDevices" ItemsSource="{x:Bind ViewModel.Devices}"
                              SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=OneWay}" SelectionChanged="OnDeviceSelected">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="app:SalonDeviceRow">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Kind}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="1" AutomationProperties.AutomationId="RevokeDevice" Content="Revogar aparelho"
                            Command="{x:Bind ViewModel.RevokeDeviceCommand}" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Cozinha" IsClosable="False">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListView AutomationProperties.AutomationId="SalonTickets" ItemsSource="{x:Bind ViewModel.Tickets}"
                              SelectedItem="{x:Bind ViewModel.SelectedTicket, Mode=OneWay}" SelectionChanged="OnTicketSelected">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="app:SalonTicketRow">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="110" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Table}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Item}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Quantity}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Wait}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind local:SalonPanelPage.LateText(Late)}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="BumpTicket" Content="Avançar"
                                Command="{x:Bind ViewModel.BumpCommand}" />
                        <Button AutomationProperties.AutomationId="RecallTicket" Content="Voltar"
                                Command="{x:Bind ViewModel.RecallCommand}" />
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
