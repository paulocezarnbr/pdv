<UserControl
    x:Class="Pdv.WinUI.CounterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Pdv.App"
    xmlns:sales="using:Pdv.Data.Sales">

    <Grid Padding="20" ColumnSpacing="20" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Quem está no caixa, e o que a abertura resolveu no TEF. -->
        <StackPanel Grid.ColumnSpan="2" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock AutomationProperties.AutomationId="Greeting" Text="{x:Bind ViewModel.Greeting}"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Grid.Column="1" AutomationProperties.AutomationId="SyncStatus" VerticalAlignment="Center"
                           Text="{x:Bind Sync.Text, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <!-- Pedido do painel que espera alguém no caixa (cancelar o que a cozinha já tem). -->
            <InfoBar AutomationProperties.AutomationId="RemoteNotice" Severity="Informational" IsClosable="False"
                     Title="Painel" Message="{x:Bind ViewModel.RemoteNotice, Mode=OneWay}"
                     IsOpen="{x:Bind Has(ViewModel.RemoteNotice), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button AutomationProperties.AutomationId="ReviewRemote" Content="Ver pedidos (Ctrl+F4)"
                            Command="{x:Bind ViewModel.ReviewRemoteCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="F4" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>
            <ItemsControl AutomationProperties.AutomationId="Recoveries" ItemsSource="{x:Bind ViewModel.Recoveries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <InfoBar IsOpen="True" IsClosable="True" Severity="Warning" Title="TEF" Message="{x:Bind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Bipar ou buscar, e os itens da venda. -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryBox" AutomationProperties.AutomationId="Query"
                         PlaceholderText="Código de barras ou nome do produto"
                         Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnQueryKeyDown" FontSize="18" />
                <Button Grid.Column="1" AutomationProperties.AutomationId="Scan" Content="Buscar"
                        Command="{x:Bind ViewModel.ScanCommand}" />
            </Grid>
            <!-- O mostrador da balança: o item pesado cobra o peso estável que está aqui. -->
            <Border Grid.Row="1" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7EF;" FontSize="16" />
                    <TextBlock AutomationProperties.AutomationId="Scale" Text="{x:Bind ViewModel.ScaleText, Mode=OneWay}"
                               FontSize="16" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Text="estável" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                               Visibility="{x:Bind ViewModel.ScaleStable, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <ListView Grid.Row="2" AutomationProperties.AutomationId="Results" MaxHeight="200"
                      ItemsSource="{x:Bind ViewModel.Results}" IsItemClickEnabled="True" ItemClick="OnResultClick"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="sales:Product">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView x:Name="LinesList" Grid.Row="3" AutomationProperties.AutomationId="Lines"
                      ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="Single"
                      SelectionChanged="OnLineSelected" BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="app:SaleLine">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Total}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Total e recebimento. -->
        <Border Grid.Row="1" Grid.Column="1" Padding="20" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Text="Total" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock AutomationProperties.AutomationId="Total" Text="{x:Bind ViewModel.Total, Mode=OneWay}"
                           FontSize="40" FontWeight="SemiBold" />
                <TextBlock AutomationProperties.AutomationId="Discount" Text="{x:Bind ViewModel.Discount, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- O cliente desta venda: cashback, pré-pago, fiado e nível. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="IdentifyCustomer" Content="Cliente"
                            Command="{x:Bind ViewModel.IdentifyCustomerCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="K" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Grid.Column="1" AutomationProperties.AutomationId="EditCustomer" Content="Editar cadastro"
                            Command="{x:Bind ViewModel.EditCustomerCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="E" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <TextBlock Grid.Column="2" AutomationProperties.AutomationId="CustomerSummary" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text="{x:Bind ViewModel.CustomerSummary, Mode=OneWay}" />
                </Grid>

                <!-- Cancelar e descontar pedem o PIN de quem pode liberar. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="CancelItem" Content="F4  Cancelar item"
                            HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelItemCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Grid.Column="1" AutomationProperties.AutomationId="Discount6" Content="F6  Desconto"
                            HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.DiscountCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F6" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>
                <!-- Atalhos de cliente, como no PDV em Python: F5 fiado, F7 cashback, F11 pré-pago, Ctrl+F6 níveis. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="ManageCredit" Content="F5 Fiado" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ManageCreditAccountCommand}">
                        <Button.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></Button.KeyboardAccelerators>
                    </Button>
                    <Button Grid.Column="1" AutomationProperties.AutomationId="ConfigureCashback" Content="F7 Cashback"
                            HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ConfigureCashbackCommand}">
                        <Button.KeyboardAccelerators><KeyboardAccelerator Key="F7" /></Button.KeyboardAccelerators>
                    </Button>
                    <Button Grid.Column="2" AutomationProperties.AutomationId="DepositPrepaid" Content="F11 Carga"
                            HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.DepositPrepaidCommand}">
                        <Button.KeyboardAccelerators><KeyboardAccelerator Key="F11" /></Button.KeyboardAccelerators>
                    </Button>
                    <Button Grid.Column="3" AutomationProperties.AutomationId="ManageTiers" Content="Níveis"
                            HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ManageTiersCommand}">
                        <Button.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="F6" /></Button.KeyboardAccelerators>
                    </Button>
                </Grid>
                <!-- O salão não é da venda: a casca abre cada tela em janela própria.
                     F8 é de quem cuida do salão; F9 é do caixa, onde a mesa vira dinheiro. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="OpenSalon" Content="F8  Salão"
                            HorizontalAlignment="Stretch" Click="OnSalonClick">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F8" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Grid.Column="1" AutomationProperties.AutomationId="OpenTables" Content="F9  Mesas"
                            HorizontalAlignment="Stretch" Click="OnTablesClick">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F9" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>
                <Button AutomationProperties.AutomationId="ShowShortcuts" Content="F1  Todos os atalhos" HorizontalAlignment="Stretch"
                        Click="OnShortcutsClick">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button AutomationProperties.AutomationId="Reprint" Content="Reimprimir cupom (Ctrl+P)" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ReprintCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="P" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button AutomationProperties.AutomationId="CloseCash" Content="F12  Fechar o caixa"
                        HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CloseCashCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F12" />
                    </Button.KeyboardAccelerators>
                </Button>

                <TextBox AutomationProperties.AutomationId="CashReceived" Header="Recebido em dinheiro"
                         PlaceholderText="valor exato"
                         Text="{x:Bind ViewModel.CashReceived, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock AutomationProperties.AutomationId="Change" Text="{x:Bind ViewModel.Change, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Button AutomationProperties.AutomationId="PayCash" Content="Dinheiro" HorizontalAlignment="Stretch"
                        Height="44" Command="{x:Bind ViewModel.PayCashCommand}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PayDebit" AutomationProperties.AutomationId="PayDebit" Content="Débito"
                            HorizontalAlignment="Stretch" Height="44" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.PayCardCommand}" />
                    <Button x:Name="PayCredit" Grid.Column="1" AutomationProperties.AutomationId="PayCredit"
                            Content="Crédito" HorizontalAlignment="Stretch" Height="44"
                            Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.PayCardCommand}" />
                    <Button x:Name="PayPix" Grid.Column="2" AutomationProperties.AutomationId="PayPix" Content="PIX"
                            HorizontalAlignment="Stretch" Height="44" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.PayCardCommand}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.AutomationId="PayPrepaid" Content="Pré-pago" HorizontalAlignment="Stretch"
                            Height="40" Command="{x:Bind ViewModel.PayPrepaidCommand}" />
                    <Button Grid.Column="1" AutomationProperties.AutomationId="PayCreditAccount" Content="Fiado"
                            HorizontalAlignment="Stretch" Height="40" Command="{x:Bind ViewModel.PayCreditAccountCommand}" />
                </Grid>

                <InfoBar AutomationProperties.AutomationId="Notice" IsOpen="{x:Bind Has(ViewModel.Notice), Mode=OneWay}"
                         IsClosable="False" Severity="Success" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />
                <InfoBar AutomationProperties.AutomationId="Error" IsOpen="{x:Bind Has(ViewModel.Error), Mode=OneWay}"
                         IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

                <!-- O que o TEF manda dizer ao cliente, na ordem em que chega. -->
                <ListView AutomationProperties.AutomationId="TefMessages" Header="TEF" MaxHeight="160"
                          ItemsSource="{x:Bind ViewModel.TefMessages}" SelectionMode="None" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
